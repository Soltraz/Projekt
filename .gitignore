# generierte / lokale Laufzeitdaten weiterhin ignorieren
zefix-vars/data/converted/
zefix-vars/data/debug/
zefix-vars/data/missing/
zefix-vars/data/uploads/
zefix-vars/data/vars/

# lokale JSON-Daten nicht pushen
zefix-vars/data/*.json

# erzeugte PDF-Ablagen
zefix-vars/public/marzo/data/

